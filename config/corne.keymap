#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |  \   |
            //                    | GUI | ESC | SPC |   | ENT | L1  | DEL |

            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R    &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F    &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V    &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
                         &kp LGUI  &kp ESC  &kp ENTER    &kp SPACE  &to 1  &kp DEL
            >;
        };

        symbol_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "symbol";
            bindings = <
&kp TILDE  &kp EXCL       &kp AT         &kp HASH          &kp LBKT              &kp RBKT                 &kp PLUS   &kp N7  &kp N8  &kp N9  &kp STAR      &kp BSPC
&kp GRAVE  &kp DOLLAR     &kp PERCENT    &kp CARET         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp MINUS  &kp N4  &kp N5  &kp N6  &kp FSLH      &kp EQUAL
&kp LSHFT  &kp AMPERSAND  &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp N0     &kp N1  &kp N2  &kp N3  &kp QUESTION  &kp PIPE
                                         &trans            &to 0                 &trans                   &trans     &to 2   &trans
            >;
        };

        fun_arrow_layer {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &kp HOME         &kp PG_DN  &kp PG_UP  &kp END    &kp C_VOLUME_UP    &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &kp LEFT         &kp DOWN   &kp UP     &kp RIGHT  &kp C_VOLUME_DOWN  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &kp PRINTSCREEN  &trans     &trans     &trans     &kp C_MUTE         &trans
                         &trans   &to 0    &trans    &trans           &to 3      &trans
            >;

            label = "fun_arrow";
        };

        bluetooth_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "bluetooth";
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &to 0         &trans          &trans  &trans  &trans
            >;
        };
    };
};
